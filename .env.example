APP_NAME=PolicyGuard AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/policyguard.db
SOURCE_DIR=./data/sources
EVALUATION_DATASET=./data/evaluation/rag-baseline.json

# Reserved for V1 RAG. They are intentionally unused in the baseline.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_FALLBACK_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_TIMEOUT_SECONDS=30

RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_FALLBACK_MODEL=
RERANK_TIMEOUT_SECONDS=30

# Reserved for V2 Agent. Never commit real keys.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=45

# Transient 408/425/429/5xx and transport failures only. Maximum allowed attempts: 5.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_SECONDS=0.5

# Optional model steps are skipped when either per-workflow budget is exhausted.
WORKFLOW_MODEL_CALL_BUDGET=3
WORKFLOW_INPUT_TOKEN_BUDGET=12000
# Set real provider prices to make the dashboard estimate meaningful; zero means local/free.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_FALLBACK_INPUT_PRICE_PER_MILLION=0

QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_CACHE=./data/query-cache/rewrites.json

# Optional isolated PDF parser services. Each implements POST /parse and returns canonical JSON.
UPLOAD_DIR=./data/uploads
MINERU_BASE_URL=
PADDLEOCR_BASE_URL=
RAPIDOCR_BASE_URL=http://127.0.0.1:9013
PPSTRUCTURE_BASE_URL=
DOCUMENT_PARSER_API_KEY=

# Optional local management protection. Leave empty for the no-login local demo.
ADMIN_API_KEY=
# Optional least-privilege key: may perform human-review decisions but not admin operations.
REVIEWER_API_KEY=
# Optional tenant isolation: JSON object mapping tenant IDs to independent API keys.
TENANT_KEYS_JSON=
RATE_LIMIT_PER_MINUTE=120

# Optional identity-preserving image-edit sidecar implementing POST /product-scene-edit.
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_TIMEOUT_SECONDS=180
