APP_NAME=PolicyGuard AI
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:////app/runtime/policyguard.db
SOURCE_DIR=/app/data/sources
UPLOAD_DIR=/app/runtime/uploads
QUERY_REWRITE_CACHE=/app/runtime/query-cache/rewrites.json

AUTH_CODE_PEPPER=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
SESSION_COOKIE_SECURE=true
ADMIN_EMAILS=CHANGE_ME@qq.com
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760
MAX_ACTIVE_JOBS_PER_TENANT=2

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
PROVIDER_MAX_ATTEMPTS=1
LLM_TIMEOUT_SECONDS=20
WORKFLOW_MODEL_CALL_BUDGET=0
WORKFLOW_INPUT_TOKEN_BUDGET=6000
QUERY_REWRITE_ENABLED=false

METRICS_API_KEY=
ADMIN_API_KEY=
REVIEWER_API_KEY=
HARNESS_SANDBOX_ENABLED=false
