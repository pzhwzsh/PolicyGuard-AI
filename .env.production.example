APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://policyguard:CHANGE_ME@postgres:5432/policyguard
SOURCE_DIR=./data/sources
UPLOAD_DIR=./data/uploads
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_VALUE
REVIEWER_API_KEY=CHANGE_ME_DIFFERENT_RANDOM_VALUE
TENANT_KEYS_JSON={"portfolio-demo":"CHANGE_ME_TENANT_KEY"}
RATE_LIMIT_PER_MINUTE=120

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
EMBEDDING_FALLBACK_MODEL=BAAI/bge-small-zh-v1.5
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_SECONDS=0.5
WORKFLOW_MODEL_CALL_BUDGET=3
WORKFLOW_INPUT_TOKEN_BUDGET=12000

# Optional identity-preserving image-edit sidecar implementing POST /product-scene-edit.
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_TIMEOUT_SECONDS=180
MAX_UPLOAD_BYTES=26214400
MAX_ACTIVE_JOBS_PER_TENANT=10
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
METRICS_API_KEY=CHANGE_ME_METRICS_KEY
OTEL_EXPORTER_OTLP_ENDPOINT=
HARNESS_SANDBOX_ENABLED=false
HARNESS_SANDBOX_IMAGE=python:3.12-alpine
MCP_SERVERS_JSON=[]
