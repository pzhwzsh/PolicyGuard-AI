APP_NAME=PolicyGuard AI
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Replace every CHANGE_ME value before deployment.
DATABASE_URL=postgresql+psycopg://policyguard:CHANGE_ME@postgres:5432/policyguard
SOURCE_DIR=/app/data/sources
UPLOAD_DIR=/app/data/uploads
EVALUATION_DATASET=/app/data/evaluation/rag-baseline.json

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME@qq.com
SMTP_AUTHORIZATION_CODE=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME@qq.com
AUTH_CODE_PEPPER=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
SESSION_COOKIE_SECURE=true

RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=26214400
MAX_ACTIVE_JOBS_PER_TENANT=10
METRICS_API_KEY=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME
REVIEWER_API_KEY=CHANGE_ME

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_FALLBACK_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_FALLBACK_MODEL=
RERANK_TIMEOUT_SECONDS=30

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=45
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_SECONDS=0.5
WORKFLOW_MODEL_CALL_BUDGET=3
WORKFLOW_INPUT_TOKEN_BUDGET=12000
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_CACHE=/app/data/query-cache/rewrites.json

OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
OTEL_EXPORTER_OTLP_ENDPOINT=
HARNESS_SANDBOX_ENABLED=false
HARNESS_SANDBOX_IMAGE=python:3.12-alpine
MCP_SERVERS_JSON=[]
